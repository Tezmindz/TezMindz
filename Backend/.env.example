# Copy to .env and fill in real values. Never commit the real .env file.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset locally to fall back to sqlite. Required in production
# (config.settings.prod raises at startup if this is missing).
# Render provides this automatically for its managed Postgres.
# DATABASE_URL=postgres://user:password@host:5432/tezmindz

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Used by config/settings/prod.py — leave default unless behind a
# proxy that already terminates TLS elsewhere.
SECURE_SSL_REDIRECT=True
